{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@loci/module-sdk": ["packages/module-sdk/src/index.ts"],
      "@loci/core-progression": ["packages/core-progression/src/index.ts"],
      "@loci/core-srs": ["packages/core-srs/src/index.ts"],
      "@loci/data-local": ["packages/data-local/src/index.ts"],
      "@loci/ai-gateway": ["packages/ai-gateway/src/index.ts"],
      "@loci/analytics": ["packages/analytics/src/index.ts"],
      "@loci/design-system": ["packages/design-system/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "modules/*/src", "apps/*/src"]
}
